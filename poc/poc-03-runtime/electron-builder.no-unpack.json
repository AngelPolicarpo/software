{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "org.comunidadep2p.poc03.nounpack",
  "productName": "poc03-runtime-nounpack",
  "directories": {
    "output": "release-nounpack"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "asar": {
    "smartUnpack": false
  },
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "linux": {
    "target": [
      "dir"
    ],
    "category": "Network"
  },
  "win": {
    "target": [
      "dir"
    ]
  },
  "electronVersion": "43.4.0"
}