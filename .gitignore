# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Env
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store

# Vite / TS
*.tsbuildinfo
.vite/

# Bundle do driver do smoke de voz (B45): reconstruído a cada `npm run smoke:voz`, nunca
# consumido pelo produto. Fora do versionamento e, por tabela, fora do lint.
frontend/dist-smoke-voz/

# Claude Code — configuração local do assistente, não é contrato do projeto
.claude/
.zcode/
.opencode/

# Grafo de conhecimento: derivado do repositório e reconstruível por extração local.
# Fica fora do versionamento — são ~9 MB que mudam inteiros a cada extração, e o que
# manda é sempre o documento normativo, não o grafo.
graphify-out/
.mcp.json
.graphifyignore

# Saída do graphify em raiz errada: a canônica é graphify-out/ na raiz do projeto
docs/graphify-out/

# Empacotamento (electron-builder) — artefatos gerados por `npm run dist*`
# O instalador sai em app/release/; os recursos montados (renderer/core copiados
# para dentro de app/dist) já caem no `dist/` acima.
app/release/
